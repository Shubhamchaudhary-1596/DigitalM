# Copy to a private .env file on the server. Never commit real credentials.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/webzoneo
PUBLIC_SITE_URL=https://webzoneo.com
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://webzoneo.com,https://www.webzoneo.com,https://admin.webzoneo.com
