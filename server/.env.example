# Copy to a private .env file on the server. Never commit real credentials.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/webzoneo
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_KEY=replace-with-a-one-time-random-setup-key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CORS_ORIGINS=https://webzoneo.com,https://www.webzoneo.com,https://admin.webzoneo.com
